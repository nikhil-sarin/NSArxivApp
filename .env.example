# Ollama configuration for local summarization
# Check available models: ollama list

SUMMARIZER_PROVIDER=ollama
PUBLIC_LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen
OLLAMA_HOST=http://localhost:11434
OCR_MODEL=gemma3:latest

# local_only | paper_cloud | allow_cloud
DATA_ROUTING_POLICY=paper_cloud
PRIVATE_LLM_PROVIDER=ollama

# Optional task-specific routes
# REPORT_LLM_PROVIDER=ollama
# REPORT_LLM_MODEL=qwen
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DEVICE=cpu

# OpenAI or any OpenAI-compatible chat-completions endpoint
# SUMMARIZER_PROVIDER=openai
# PUBLIC_LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=replace-me
# LLM_MODEL=gpt-4o-mini

# Optional personal citation-opportunity workflow (disabled for public installs)
# NSARXIV_CONTRIBUTIONS_PATH=config/contributions.json
# AUTO_CITATION_DISCOVERY=true
# LOCAL_ORCHESTRATOR_URL=http://127.0.0.1:8775/v1/import-bundles
# LOCAL_ORCHESTRATOR_UI_URL=http://127.0.0.1:8775
# LOCAL_ORCHESTRATOR_API_TOKEN=
TRACKING_RELEVANCE_THRESHOLD=50
